# Bridge — copy to .env and fill. Never commit .env
# OpenCode Zen (for ai.summarize / ai.transcribe cloud fallback)
# Get your key from https://zen.opencode.ai (user will provide)
OPENCODE_ZEN_API_KEY=your_zen_key_here
OPENCODE_ZEN_BASE_URL=https://zen.opencode.ai/v1
OPENCODE_ZEN_MODEL=zen-3
# Optional: force local AI even if Zen key exists
# BRIDGE_LOCAL_AI=1
# Optional: allow cloud mock when no key (for CI/E2E)
# BRIDGE_ALLOW_CLOUD_MOCK=1
# Optional: fail cloud if you want to test fallback
# BRIDGE_CLOUD_FAIL=1
